{
  "name": "@jetonpeche/xml-airstream",
  "version": "1.1.0",
  "description": "High-performance, zero-dependency streaming XML parser and serializer. Features a state-machine lexer and decorator-based object-document mapping (ODM) for TypeScript.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JetonpecheCorp/xml-airstream.git"
  },
  "keywords": [
    "xml",
    "parser",
    "xml-parser",
    "streaming",
    "stream",
    "lexer",
    "state-machine",
    "ast",
    "serializer",
    "decorators",
    "typescript-decorators",
    "object-mapper",
    "xml-to-json",
    "json-to-xml",
    "zero-dependency",
    "high-performance"
  ],
  "author": "jetonpeche",
  "license": "MIT",
  "readme": "https://github.com/JetonpecheCorp/xml-airstream#readme",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}